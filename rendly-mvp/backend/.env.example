# Copy to .env and fill in. Single file for all backend services (Docker + local).

# === Shared ===
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres for chat appends (avoids 57014). Use the pooler URI from Supabase Dashboard -> Settings -> Database (Transaction or Session mode). Do not use db.REF.supabase.co if you see "Tenant or user not found".
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === Service ports ===
# Auth (login, JWT, OAuth) - frontend uses this for /api/auth and /api/users
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=3002
MATCHING_SERVICE_PORT=3003
VIDEO_SERVICE_PORT=3005
MODERATION_SERVICE_PORT=3006
HUDDLE_SERVICE_PORT=3007
ADMIN_SERVICE_PORT=3008

# === Auth service ===
JWT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password reset email (SMTP). If not set, reset link is only logged (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_NAME=Rendly
# APP_URL: public app address incl. any sub-path, used in emailed links.
APP_URL=https://anoryxtechsolutions.com/rendly.app

# Spark video relay (TURN, coturn use-auth-secret / REST credentials). With both set, GET /api/match/ice
# returns short-lived relay credentials so partners never see each other's IP; otherwise public STUN only.
# TURN_URLS: comma-separated turn:/turns: URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
# TURN_SHARED_SECRET: the coturn static-auth-secret. Keep it secret; never commit a real value.
TURN_SHARED_SECRET=
# Or a fixed TURN login (Metered, Twilio, ...), used when TURN_SHARED_SECRET is empty.
TURN_USERNAME=
TURN_CREDENTIAL=

# === Moderation service ===
OPENAI_API_KEY=

# Admin console (https://<app>/admin). Set ADMIN_PASSWORD (plain text, host env only, never in git)
# or ADMIN_PASSWORD_HASH (bcrypt, `npm run admin:hash-password` in services/auth-service; wins if both set).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Where urgent alerts (attacks, error spikes, traffic peaks) are emailed. Defaults to ADMIN_EMAIL.
ADMIN_ALERT_EMAIL=
# Alert thresholds (per 5 minutes) and the minimum gap between two alerts of one kind.
ALERT_TRAFFIC_PER_5MIN=1000
ALERT_5XX_PER_5MIN=50
ALERT_AUTH_FAILURES_PER_IP_5MIN=40
ALERT_RATE_LIMITED_PER_5MIN=300
ALERT_COOLDOWN_MINUTES=15
# auth-service sends Rendly Team messages (welcome, query replies) through chat-service.
CHAT_SERVICE_URL=http://127.0.0.1:4002
RENDLY_TEAM_USER_ID=f0f0f0f0-0000-4000-8000-000000000001
